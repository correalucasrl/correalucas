<section id="habilidades" class="border-t border-line bg-soft py-20">
    <div class="container-page">
        <h2 class="section-title">@Content.Skills.Title</h2>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var g in Content.Skills.Groups)
            {
                <div class="card p-5">
                    <h3 class="text-sm font-semibold text-accent">@g.Name</h3>
                    <ul class="mt-3 flex flex-wrap gap-2">
                        @foreach (var s in g.Items)
                        {
                            <li class="chip">@s</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public SiteContent Content { get; set; } = default!;
}
