<section id="proyectos" class="border-t border-line py-20">
    <div class="container-page">
        <h2 class="section-title">@Content.Work.Title</h2>
        <p class="mt-3 max-w-2xl text-muted">@Content.Work.Intro</p>

        <div class="mt-12 space-y-10">
            @foreach (var (cs, i) in Content.Work.Cases.Select((x, i) => (x, i)))
            {
                <article id="@cs.Id" class="card overflow-hidden">
                    <div class="p-6 sm:p-8">
                        <div class="flex flex-wrap items-center gap-3">
                            <span class="font-mono text-sm text-accent">0@(i + 1)</span>
                            <span class="eyebrow">@cs.Tag</span>
                        </div>
                        <h3 class="mt-3 text-2xl font-bold tracking-tight">@cs.Title</h3>
                        <p class="mt-2 text-muted">@cs.Summary</p>
                    </div>

                    <figure class="border-y border-line bg-soft px-4 py-6 sm:px-8">
                        <CaseDiagram Kind="cs.Diagram" Lang="Content.Lang" />
                        <figcaption class="mt-3 text-center text-sm text-muted">@cs.DiagramCaption</figcaption>
                    </figure>

                    <div class="grid gap-6 p-6 sm:p-8 md:grid-cols-3">
                        <div>
                            <h4 class="text-sm font-semibold">@Content.Work.ProblemLabel</h4>
                            <p class="mt-2 text-sm leading-relaxed text-muted text-pretty">@cs.Problem</p>
                        </div>
                        <div>
                            <h4 class="text-sm font-semibold">@Content.Work.SolutionLabel</h4>
                            <p class="mt-2 text-sm leading-relaxed text-muted text-pretty">@cs.Solution</p>
                        </div>
                        <div>
                            <h4 class="text-sm font-semibold">@Content.Work.ResultLabel</h4>
                            <p class="mt-2 text-sm leading-relaxed text-muted text-pretty">@cs.Result</p>
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-2 border-t border-line px-6 py-4 sm:px-8">
                        @foreach (var t in cs.Stack)
                        {
                            <span class="chip">@t</span>
                        }
                    </div>
                </article>
            }
        </div>

        <p class="mt-6 text-sm text-muted">@Content.Work.Note</p>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public SiteContent Content { get; set; } = default!;
}
