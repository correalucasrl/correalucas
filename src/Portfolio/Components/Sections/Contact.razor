<section id="contacto" class="border-t border-line bg-accent py-20 text-paper">
    <div class="container-page">
        <h2 class="section-title">@Content.Contact.Title</h2>
        <p class="mt-4 max-w-2xl text-lg opacity-90 text-pretty">@Content.Contact.Pitch</p>
        <div class="mt-8 flex flex-wrap gap-3">
            <a href="mailto:@Profile.Email" class="btn bg-paper text-accent hover:opacity-90">
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                @Content.Contact.EmailLabel
            </a>
            <a href="@Profile.LinkedIn" target="_blank" rel="noopener" class="btn border border-paper/40 hover:bg-paper/10">
                <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm7 0h3.8v1.6h.06c.53-1 1.82-2.06 3.75-2.06 4 0 4.74 2.64 4.74 6.07V21h-4v-5.2c0-1.24-.02-2.84-1.73-2.84-1.73 0-2 1.35-2 2.75V21h-4V9.5Z" /></svg>
                @Content.Contact.LinkedInLabel
            </a>
            <a href="@Content.CvFile" download class="btn border border-paper/40 hover:bg-paper/10">
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" /></svg>
                @Content.Contact.CvLabel
            </a>
        </div>
        <p class="mt-6 font-mono text-sm opacity-80">@Profile.Email</p>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public SiteContent Content { get; set; } = default!;
}
