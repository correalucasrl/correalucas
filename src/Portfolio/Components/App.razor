<!DOCTYPE html>
<html lang="@(IsEnglish ? "en" : "es-AR")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <meta name="theme-color" content="#0f5c6e" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/site.css"]" />
    <HeadOutlet />
</head>

<body>
    <Routes />
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private bool IsEnglish =>
        HttpContext?.Request.Path.StartsWithSegments("/en", StringComparison.OrdinalIgnoreCase) == true;
}
